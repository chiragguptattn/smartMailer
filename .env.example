# Sender domain(s) to process (required for run). Comma-separated for multiple.
# Example: partner.com  or  client.com, vendor.org
GMAIL_FROM_DOMAIN=example.com

# Path to OAuth desktop client JSON from Google Cloud Console
GMAIL_CREDENTIALS_PATH=./credentials.json

# Where the refresh token is stored after first login
GMAIL_TOKEN_PATH=./token.json

# Optional: limit how many matching threads to process per run
GMAIL_MAX_THREADS=10

# Optional: Gmail label applied after a draft is created (created if missing)
GMAIL_PROCESSED_LABEL=AI/Drafted

# Required: Cursor API key — every reply is curated then drafted by Cursor
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Always-on watcher: seconds between unread inbox polls (min 30)
GMAIL_POLL_SECONDS=120

# HTML draft typography
# DRAFT_FONT_FAMILY=Calibri, Arial, Helvetica, sans-serif
# DRAFT_FONT_SIZE=14px

# Your display name for sign-off
AGENT_SIGN_OFF_NAME=

# Dry-run: analyze and print drafts without writing to Gmail
# GMAIL_DRY_RUN=1

# Cursor Cloud secrets (preferred over files when set):
# GMAIL_CREDENTIALS_JSON=
# GMAIL_TOKEN_JSON=

# --- Calendar digest: Gmail + Zoho Calendar schedule email ---
# Manual run: python main.py calendar-digest --date 25-08-2026
# If --date is omitted, today's date in CALENDAR_DIGEST_TIMEZONE is used.
CALENDAR_DIGEST_TIMEZONE=Asia/Kolkata
CALENDAR_DIGEST_RECIPIENTS=madhav.khanna@tothenew.com,madhavkhanna@zohomail.in
CALENDAR_DIGEST_AI=auto
CALENDAR_DIGEST_AI_MODEL=composer-2.5

# Google Calendar to read, and Gmail account used to send the digest.
# Run `python main.py calendar-auth` once to create token.calendar.json.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_EMAIL=madhav.khanna@tothenew.com
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=./token.calendar.json
# GOOGLE_CALENDAR_CREDENTIALS_JSON=
# GOOGLE_CALENDAR_TOKEN_JSON=

# Secondary calendar via Zoho Calendar API.
# Create a Zoho OAuth app, then run `python main.py zoho-auth`.
SECONDARY_CALENDAR_LABEL=Zoho
SECONDARY_CALENDAR_EMAIL=madhavkhanna@zohomail.in
ZOHO_EMAIL=madhavkhanna@zohomail.in
ZOHO_CLIENT_ID=1000.XSZSNGH0V40ZPBPR6OM13SV6ZIFUQU
ZOHO_CLIENT_SECRET=c7478d6c02d4f170c7675a77b7afc0545971fbaf4c
ZOHO_REDIRECT_URI=http://localhost:8765/callback
ZOHO_TOKEN_PATH=./zoho_token.json
ZOHO_CALENDAR_UID=primary
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CALENDAR_API_URL=https://calendar.zoho.com
# ZOHO_TOKEN_JSON=
# ZOHO_REFRESH_TOKEN=
